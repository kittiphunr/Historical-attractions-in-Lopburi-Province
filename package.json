{
  "name": "lopburi-heritage",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page แหล่งท่องเที่ยวประวัติศาสตร์จังหวัดลพบุรี (Tailwind CSS + CSS 3D)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "build:js": "esbuild src/three-scenes.js --bundle --minify --format=iife --legal-comments=none --outfile=assets/js/three-scenes.js",
    "build": "npm run build:css && npm run build:js",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "start": "node server.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "three": "^0.187.0",
    "esbuild": "^0.28.2"
  }
}
