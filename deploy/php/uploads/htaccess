# ไฟล์ที่อัปโหลดจากหน้าผู้ดูแล (รูปในเนื้อหา โมเดล 3 มิติ): เสิร์ฟได้เฉพาะรูปและ .glb ห้ามเรียกไฟล์ชนิดอื่น (รวมถึง .php) (ชื่อไฟล์ตอนวางบนโฮสต์ต้องเป็น .htaccess)
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "\.(webp|jpe?g|png|glb)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "\.(webp|jpe?g|png|glb)$">
    Allow from all
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
