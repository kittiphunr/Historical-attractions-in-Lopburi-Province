# ไฟล์ภายในของ API: ห้ามเปิดจากเว็บ (ชื่อไฟล์ตอนวางบนโฮสต์ต้องเป็น .htaccess)
<FilesMatch "^(lib\.php|config\.php|config\.sample\.php|places\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
