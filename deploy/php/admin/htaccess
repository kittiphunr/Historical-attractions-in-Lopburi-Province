# หน้าผู้ดูแล: ไม่ให้เสิร์ชเอนจินจัดทำดัชนี และไม่แคช (ชื่อไฟล์ตอนวางบนโฮสต์ต้องเป็น .htaccess)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
</IfModule>
Options -Indexes
DirectoryIndex index.php
# ไฟล์ภายในของหน้าผู้ดูแล: ห้ามเปิดจากเว็บโดยตรง
<FilesMatch "^common\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
